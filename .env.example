# Copie para .env (que não vai para o git) e preencha.

# Locutor no Gemini TTS (padrão quando a chave existe). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TTS_VOZ=Lumi
# Pedidos por minuto do seu plano (grátis: 3). Com faturamento ativo, aumente.
GEMINI_TTS_RPM=3
# GEMINI_TTS_MODELO=gemini-3.8-flash-tts
# Voz usada quando a cota diária do Gemini acaba: azure, espeak ou mudo
# LOCUTOR_RESERVA=espeak

# Alternativa: Azure Speech (usado se não houver GEMINI_API_KEY)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_VOICE=pt-BR-AntonioNeural

# Banco (Neon ou outro Postgres). Sem ele, o `pnpm liga` usa um banco local em .cache/.
# DATABASE_URL=postgres://...

# Instagram (API com Login do Instagram). Veja docs/implantacao.md.
# O token de longa duração vale 60 dias; o job renova sozinho e guarda o novo no banco e no KV.
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_API_VERSAO=v25.0

# Cloudflare: R2 (vídeos e dados do site) e KV (agenda de publicação)
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLICO=varzeao-publico
R2_BUCKET_PRIVADO=varzeao-privado
# Endereço público do bucket público (https://pub-xxxx.r2.dev ou domínio próprio)
R2_URL_PUBLICA=
# Token da API com permissão "Workers KV Storage: Edit"
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
