{
  "name": "liga-dos-seguidores",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "calibrar": "pnpm --filter @liga/sim calibrar",
    "demo": "pnpm --filter @liga/renderer demo",
    "gravar": "pnpm --filter @liga/renderer gravar",
    "vozes": "pnpm --filter @liga/renderer vozes",
    "testar-grito": "pnpm --filter @liga/renderer testar-grito",
    "liga": "pnpm --filter @liga/worker liga",
    "site": "pnpm --filter @liga/site dev",
    "site:build": "pnpm --filter @liga/site build",
    "verificar": "pnpm --filter @liga/worker verificar",
    "job": "pnpm --filter @liga/worker job",
    "edge:deploy": "pnpm --filter @liga/edge deploy",
    "simular": "pnpm --filter @liga/worker simular"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
